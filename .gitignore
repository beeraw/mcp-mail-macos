# Virtualenv and bytecode
.venv/
venv/
__pycache__/
*.py[cod]

# The search index is rebuilt from Mail's store:
#   python3 mail_index.py --build
index.sqlite
index.sqlite-wal
index.sqlite-shm
index.sqlite.sync.lock
index.sqlite.building
index.sqlite.building-wal
index.sqlite.building-shm
index.sqlite.sync.lock.stale.*

# Drafts, their archive and the sent ledger hold real message content
mails/

# Named searches (saved_search tool)
saved_searches.json
saved_searches.json.*
.saved_searches.*.tmp

# Background sync agent output
launchd/sync.log

# Local settings: copy config.example.json to config.json
config.json

# macOS
.DS_Store

# Search evaluation pairs and results hold real message subjects
# (see eval.example.json for the format)
eval/

# Swift tools build output (see mail_attachments.py)
tools/build/
attachments.sqlite
attachments.sqlite-wal
attachments.sqlite-shm
attachments.sqlite.sync.lock
attachments.sqlite.sync.lock.stale.*

# Embeddings for search by meaning (see mail_vectors.py)
vectors.sqlite
vectors.sqlite-wal
vectors.sqlite-shm
vectors.sqlite.sync.lock
vectors.sqlite.sync.lock.stale.*
